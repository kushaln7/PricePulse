# Server Port (auto-assigned by Render, or 8000 locally)
PORT=8000

# Allowed CORS origins, comma-separated (e.g., http://localhost:3000,https://pricepulse.vercel.app)
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Keep disabled on ephemeral deployments unless persistent model storage and an authenticated scheduler are configured.
ONLINE_LEARNING_ENABLED=false
